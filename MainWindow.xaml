<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz &amp; Wett-App"
        Height="540"
        Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#0E1410">

    <Window.Resources>
        <!-- Moderne Card -->
        <Style x:Key="CardStyle" TargetType="Grid">
            <Setter Property="Margin" Value="20"/>
            <!-- Grid hat keine Padding-Eigenschaft, daher entfernt -->
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#232D23" Offset="0"/>
                        <GradientStop Color="#111811" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0.97"/>
        </Style>

        <!-- Moderner TextBox-Style mit CornerRadius -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderBrush" Value="#3E7F3E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="4"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">

        <!-- START CARD -->
        <Grid x:Name="StartCard" Style="{StaticResource CardStyle}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A4D2A" Offset="0"/>
                    <GradientStop Color="#0E140F" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                <TextBlock Text="Fussball Quiz &amp; Wett-App"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="CurrentUserText"
                           Text=""
                           Foreground="LightGray"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <TextBlock Text="Benutzername"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="UsernameBox"/>

                <Button x:Name="LoginButton"
                        Content="Login"
                        Click="LoginButton_Click"
                        Margin="0,8,0,0"/>

                <Button x:Name="StartButton"
                        Content="Ohne Login starten"
                        Click="StartButton_Click"
                        Margin="0,8,0,0"/>
            </StackPanel>

            <TextBlock Text="© 2025 Fussballquiz-Team"
                       Foreground="LightGray"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,12"/>
        </Grid>

        <!-- SELECTION CARD -->
        <Grid x:Name="SelectionCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="QuizSelectionTitle"
                       FontSize="28"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="Real Madrid Quiz" Click="RealQuiz_Click"/>
                    <Button Content="FC Barcelona Quiz" Click="BarcaQuiz_Click"/>
                    <Button Content="Champions League Quiz" Click="CLQuiz_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Highscores"
                               Foreground="White"
                               FontSize="20"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="HighscoreList"
                             Height="250"
                             Background="#1A1A1A"
                             Foreground="White"
                             BorderThickness="0"/>

                    <Button Content="Highscores löschen"
                            Click="ClearHighscores_Click"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- QUIZ PANEL -->
        <Grid x:Name="QuizPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="WelcomePanel" Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Quiz gestartet"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="ProgressText"
                           Foreground="LightGray"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <TextBlock x:Name="QuestionText"
                           FontSize="22"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="AnswerBox" Margin="0,0,0,8"/>

                <Button Content="Antwort bestätigen"
                        Width="240"
                        Click="NextQuestion_Click"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
