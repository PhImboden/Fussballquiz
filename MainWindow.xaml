<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz &amp; Wett-App"
        Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FF0E1410">

    <Grid>
        <!-- Hintergrund mit Verlauf -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1F4D1F" Offset="0.0"/>
                <GradientStop Color="#FF0E1410" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Titel -->
        <TextBlock Name="TitleText"
                   Text="Fussball Quiz &amp; Wett-App"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"/>

        <!-- Buttons im StackPanel -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Button Content="Login" Height="40" Margin="0,0,0,10" Click="LoginButton_Click"/>
            <Button Content="Ohne Login starten" Height="40" Margin="0,0,0,10" Click="StartButton_Click"/>
        </StackPanel>

        <!-- Fußzeile -->
        <TextBlock Text="© 2025 Fussballquiz-Team"
                   Foreground="LightGray"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,15"/>
    </Grid>

</Window>
    


