<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz &amp; Wett-App"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FF0E1410">

    <Grid x:Name="RootGrid">

        <!-- START CARD -->
        <Grid x:Name="StartCard">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1F4D1F" Offset="0.0"/>
                    <GradientStop Color="#FF0E1410" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                <TextBlock Text="Fussball Quiz &amp; Wett-App"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <!-- Anzeige des aktuellen Users (wird vom Code gesetzt) -->
                <TextBlock x:Name="CurrentUserText"
                           Text=""
                           Foreground="LightGray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="320">

                <TextBlock Text="Benutzername"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="UsernameBox"
                         Height="36"
                         FontSize="16"
                         Margin="0,0,0,12"
                         Text=""/>

                <Button x:Name="LoginButton"
                        Content="Login"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="LoginButton_Click"/>

                <Button x:Name="StartButton"
                        Content="Ohne Login starten"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="StartButton_Click"/>
            </StackPanel>

            <TextBlock Text="© 2025 Fussballquiz-Team"
                       Foreground="LightGray"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,15"/>
        </Grid>

        <!-- SELECTION CARD (Quiz-Auswahl + Highscores) -->
        <Grid x:Name="SelectionCard" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock x:Name="QuizSelectionTitle"
                           FontSize="26"
                           Foreground="White"
                           Margin="0,0,0,10"
                           Text="Wähle dein Quiz" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="Real Madrid Quiz" Width="260" Height="46" Margin="0,6,0,0" Click="RealQuiz_Click"/>
                    <Button Content="FC Barcelona Quiz" Width="260" Height="46" Margin="0,12,0,0" Click="BarcaQuiz_Click"/>
                    <Button Content="Champions League Quiz" Width="260" Height="46" Margin="0,12,0,0" Click="CLQuiz_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Highscores" Foreground="White" FontSize="18" Margin="0,0,0,8"/>
                    <ListBox x:Name="HighscoreList" Height="220"/>
                    <Button Content="Highscores löschen" Margin="0,8,0,0" Click="ClearHighscores_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- QUIZ PANEL -->
        <Grid x:Name="QuizPanel" Visibility="Collapsed" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Optionales Welcome-Panel (wird im Code ggf. ausgeblendet) -->
            <StackPanel x:Name="WelcomePanel" Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Quiz gestartet" FontSize="20" Foreground="White" />
                <TextBlock x:Name="ProgressText" Text="" Foreground="LightGray" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <TextBlock x:Name="QuestionText"
                           FontSize="22"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="AnswerBox"
                         Height="36"
                         Margin="0,8,0,12"
                         FontSize="16"/>

                <Button Content="Antwort bestätigen"
                        Width="220"
                        Height="44"
                        Click="NextQuestion_Click"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
