<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz &amp; Wett-App"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FF0E1410">

    <Grid x:Name="RootGrid">

        <!-- LOGIN / START SCREEN -->
        <Grid x:Name="StartScreen">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1F4D1F" Offset="0.0"/>
                    <GradientStop Color="#FF0E1410" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="Fussball Quiz &amp; Wett-App"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,40,0,0"/>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="300">

                <!-- Beschriftung für Benutzername -->
                <!--<TextBlock Text="Benutzername"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,5"/>-->

                <!--<TextBox x:Name="UsernameBox"
                         Height="35"
                         FontSize="18"
                         Margin="0,0,0,15"
                         Text=""/>-->

                <Button Content="Login"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="LoginButton_Click"/>

                <Button Content="Ohne Login starten"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="StartButton_Click"/>
            </StackPanel>

            <TextBlock Text="© 2025 Fussballquiz-Team"
                       Foreground="LightGray"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,15"/>
        </Grid>

        <!-- QUIZ AUSWAHL -->
        <Grid x:Name="QuizSelection" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="QuizSelectionTitle"
                           FontSize="26"
                           Foreground="White"
                           Margin="0,0,0,30"
                           Text="Wähle dein Quiz" />

                <Button Content="Real Madrid Quiz" Width="250" Height="45" Margin="0,10,0,0" Click="RealQuiz_Click"/>
                <Button Content="FC Barcelona Quiz" Width="250" Height="45" Margin="0,10,0,0" Click="BarcaQuiz_Click"/>
                <Button Content="Champions League Quiz" Width="250" Height="45" Margin="0,10,0,0" Click="CLQuiz_Click"/>
            </StackPanel>
        </Grid>

        <!-- QUIZ SCREEN -->
        <Grid x:Name="QuizScreen" Visibility="Collapsed" Margin="40">
            <StackPanel>
                <TextBlock x:Name="QuestionText"
                           FontSize="24"
                           Foreground="White"
                           TextWrapping="Wrap"/>

                <TextBox x:Name="AnswerBox"
                         Height="35"
                         Margin="0,20,0,20"
                         FontSize="18"/>

                <Button Content="Antwort bestätigen"
                        Width="200"
                        Height="45"
                        Click="NextQuestion_Click"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
