<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz"
        Height="540"
        Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#0E1410">

    <Window.Resources>
        <!-- Farbpalette -->
        <SolidColorBrush x:Key="PrimaryGreen" Color="#46C46D"/>
        <Color x:Key="PrimaryGreenDark">#2D653D</Color>
        <SolidColorBrush x:Key="SurfaceMid" Color="#1A1F1A"/>

        <!-- Schatten -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.45"/>

        <!-- Base Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Margin" Value="30"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SurfaceMid}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <!-- Buttons modern -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="MediumSpringGreen" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryGreenDark}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox modern -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#161A16"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">

        <!-- START CARD -->
        <Border x:Name="StartCard" Style="{StaticResource CardStyle}">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                    <TextBlock Text="Fussball Quiz"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentUserText"
                               Foreground="LightGray"
                               FontSize="14"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                    <TextBlock Text="Benutzername" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameBox" Height="50"/>
                    <Button x:Name="LoginButton" Content="Login" Click="LoginButton_Click"/>
                    <Button x:Name="StartButton" Content="Ohne Login starten" Click="StartButton_Click"/>
                </StackPanel>

                <TextBlock Text="© 2025 Fussballquiz-Team"
                           Foreground="LightGray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,12"/>
            </Grid>
        </Border>

        <!-- SELECTION CARD -->
        <Border x:Name="SelectionCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="QuizSelectionTitle"
                           FontSize="28"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,12"/>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- QUIZ BUTTONS -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="Real Madrid Quiz" Click="RealQuiz_Click"/>
                        <Button Content="FC Barcelona Quiz" Click="BarcaQuiz_Click"/>
                        <Button Content="FC Bayern München" Click="BayernQuiz_Click"/>
                        <Button Content="Liverpool FC" Click="LiverpoolQuiz_Click"/>
                        <Button Content="Juventus Turin" Click="JuveQuiz_Click"/>
                        <Button Content="Premier League" Click="PremierQuiz_Click"/>
                        <Button Content="Bundesliga" Click="BundesligaQuiz_Click"/>
                        <Button Content="Champions League" Click="CLQuiz_Click"/>
                    </StackPanel>

                    <!-- HIGHSCORES -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Highscores"
                                   FontSize="20"
                                   Margin="0,0,0,10"/>
                        <ListBox x:Name="HighscoreList"
                                 Height="250"
                                 Background="#1A1A1A"
                                 Foreground="White"
                                 BorderThickness="0"/>
                        <Button Content="Highscores löschen"
                                Height="40"
                                Click="ClearHighscores_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- QUIZ PANEL -->
        <Border x:Name="QuizPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
               
                <TextBlock x:Name="ProgressText"
                           Foreground="LightGray"
                           FontSize="14"
                           Margin="0,0,0,10"/>
    

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock x:Name="QuestionText"
                               FontSize="22"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TextBox x:Name="AnswerBox" Margin="0,0,0,8"/>
                    <Button Content="Antwort bestätigen"
                            Width="240"
                            Click="NextQuestion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
