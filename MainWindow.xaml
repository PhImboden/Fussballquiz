<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz &amp; Wett-App"
        Height="540"
        Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#0E1410">

    <Window.Resources>

        <!-- Farbpalette -->
        <SolidColorBrush x:Key="PrimaryGreen" Color="#46C46D"/>
        <Color x:Key="PrimaryGreenDark">#2D653D</Color>
        <Color x:Key="SurfaceDark">#121512</Color>
        <SolidColorBrush x:Key="SurfaceMid" Color="#1A1F1A"/>
        <Color x:Key="SurfaceLight">#242B24</Color>

        <!-- Shadow -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.45"/>

        <!-- Base card: Style für Border (Grid hat keine CornerRadius) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Margin" Value="30"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SurfaceMid}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <!-- Buttons modern neon -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="MediumSpringGreen" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryGreenDark}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox modern -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#161A16"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="4"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Textblock titles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>


    <Grid x:Name="RootGrid">

        <!-- START CARD -->
        <Border x:Name="StartCard" Style="{StaticResource CardStyle}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A4D2A" Offset="0"/>
                    <GradientStop Color="#0E140F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                    <TextBlock Text="Fussball Quiz &amp; Wett-App"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="CurrentUserText"
                               Text=""
                               Foreground="LightGray"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                    <TextBlock Text="Benutzername"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="UsernameBox" Height="50"/>

                    <Button x:Name="LoginButton" Height="50"
                            Content="Login"
                            Click="LoginButton_Click"
                            Margin="0,8,0,0"/>

                    <Button x:Name="StartButton" Height="50"
                            Content="Ohne Login starten"
                            Click="StartButton_Click"
                            Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock Text="© 2025 Fussballquiz-Team"
                           Foreground="LightGray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,12"/>
            </Grid>
        </Border>

        <!-- SELECTION CARD -->
        <Border x:Name="SelectionCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="QuizSelectionTitle"
                           FontSize="28"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,0" Width="260">
                        <!-- Quiz Buttons verwenden jetzt den gleichen Style wie Login -->
                        <Button Content="Real Madrid Quiz" Height="50" Click="RealQuiz_Click" Margin="0,0,0,8"/>
                        <Button Content="FC Barcelona Quiz" Height="50" Click="BarcaQuiz_Click" Margin="0,0,0,8"/>
                        <Button Content="Champions League Quiz" Height="50" Click="CLQuiz_Click" Margin="0,0,0,8"/>
                    </StackPanel>


                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Highscores"
                                   Foreground="White"
                                   FontSize="20"
                                   Margin="0,0,0,10"/>

                        <ListBox x:Name="HighscoreList"
                                 Height="250"
                                 Background="#1A1A1A"
                                 Foreground="White"
                                 BorderThickness="0"/>

                        <Button Content="Highscores löschen" Height="25"
                                Click="ClearHighscores_Click"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- QUIZ PANEL -->
        <Border x:Name="QuizPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="WelcomePanel" Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Quiz gestartet"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="ProgressText"
                               Foreground="LightGray"
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock x:Name="QuestionText"
                               FontSize="22"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="AnswerBox" Margin="0,0,0,8"/>

                    <Button Content="Antwort bestätigen"
                            Width="240"
                            Click="NextQuestion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Window>
