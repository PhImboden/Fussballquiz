<Window x:Class="Fussballquiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fussball Quiz &amp; Wett-App"
        Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FF0E1410">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1F4D1F" Offset="0.0"/>
                <GradientStop Color="#FF0E1410" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <TextBlock Text="Fussball Quizller"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"
         />
        <Button Content="Login&#xD;&#xA;" HorizontalAlignment="Left" Margin="487,295,0,0" VerticalAlignment="Top" Width="67" RenderTransformOrigin="0.5,0.5" Height="25" Click="Button_Click_1">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button Content="Ohne Login Starten" HorizontalAlignment="Left" Margin="273,295,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="25" Click="Button_Click_2" />
        <Image HorizontalAlignment="Left" Height="153" Margin="320,126,0,0" VerticalAlignment="Top" Width="208"/>



    </Grid>
    
</Window>
    


